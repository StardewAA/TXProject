<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="WMS">
  <process id="__PROCESS_KEY__" name="WMS __ORDER_NAME__审批" isExecutable="true">
    <startEvent id="start" name="提交__ORDER_NAME__审批"/>
    <sequenceFlow id="toApproval" sourceRef="start" targetRef="receiptApproval"/>
    <userTask id="receiptApproval" name="仓库负责人审批">
      <extensionElements>
        <flowable:candidateStrategy>10</flowable:candidateStrategy>
        <flowable:candidateParam>__APPROVER_ROLE_ID__</flowable:candidateParam>
        <flowable:approveType>1</flowable:approveType>
        <flowable:approveMethod>3</flowable:approveMethod>
        <flowable:reasonRequire>true</flowable:reasonRequire>
        <flowable:assignEmptyHandlerType>2</flowable:assignEmptyHandlerType>
        <flowable:assignStartUserHandlerType>1</flowable:assignStartUserHandlerType>
        <flowable:rejectHandlerType>1</flowable:rejectHandlerType>
      </extensionElements>
      <multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${coll_userList}">
        <completionCondition>${nrOfCompletedInstances > 0}</completionCondition>
      </multiInstanceLoopCharacteristics>
    </userTask>
    <sequenceFlow id="toEnd" sourceRef="receiptApproval" targetRef="end"/>
    <endEvent id="end" name="审批结束"/>
  </process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="__PROCESS_KEY__">
      <bpmndi:BPMNShape id="startShape" bpmnElement="start"><dc:Bounds x="100" y="120" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approvalShape" bpmnElement="receiptApproval"><dc:Bounds x="210" y="98" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endShape" bpmnElement="end"><dc:Bounds x="410" y="120" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="approvalEdge" bpmnElement="toApproval"><di:waypoint x="136" y="138"/><di:waypoint x="210" y="138"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="endEdge" bpmnElement="toEnd"><di:waypoint x="330" y="138"/><di:waypoint x="410" y="138"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
