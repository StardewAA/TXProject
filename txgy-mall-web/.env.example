# Existing storefront URL, including its port. No domain change is required.
VITE_MALL_PUBLIC_BASE_URL=
# Classroom LAN deployment only. Keep false for Internet production deployment.
VITE_MALL_DEMO_MODE=true
# Leave empty to suggest the current hostname with the H5 port below.
VITE_MALL_H5_URL=
VITE_MALL_H5_PORT=3000

# Verified public OSS/CDN HTTPS origin; migrated images take precedence over legacy fallbacks.
VITE_PUBLIC_IMAGE_ORIGIN=

# Optional external release override. Leave empty to use the bundled, signed APK
# and public/downloads/android-release.json generated by txgy-mall-android/build.ps1.
VITE_ANDROID_APK_URL=
VITE_ANDROID_APP_VERSION=
VITE_ANDROID_FILE_SIZE=
VITE_ANDROID_RELEASE_DATE=
VITE_ANDROID_MIN_VERSION=
VITE_ANDROID_SHA256=
VITE_ANDROID_PERMISSIONS_SUMMARY=
VITE_MOBILE_FEEDBACK_URL=
