FROM node:22-alpine AS builder

WORKDIR /workspace/txgy-ui-admin-vben

RUN corepack enable && corepack prepare pnpm@11.7.0 --activate

COPY txgy-ui-admin-vben/ ./

ENV CI=true

# The repository pins a mirror that intermittently times out from Docker.
# Keep the repository unchanged and use the official registry only in this local image.
RUN sed -i 's#^registry=.*#registry=https://registry.npmjs.org#' .npmrc

RUN pnpm install --frozen-lockfile

# pnpm may skip optional native packages when the mirror times out. Download the
# two bindings directly into the locations used by pnpm's virtual store.
RUN set -eux; \
    mkdir -p /tmp/rolldown-bindings; \
    wget -q -O /tmp/rolldown-bindings/rc17.tgz https://registry.npmjs.org/@rolldown/binding-linux-x64-musl/-/binding-linux-x64-musl-1.0.0-rc.17.tgz; \
    mkdir -p node_modules/.pnpm/rolldown@1.0.0-rc.17/node_modules/rolldown/node_modules/@rolldown/binding-linux-x64-musl; \
    tar -xzf /tmp/rolldown-bindings/rc17.tgz --strip-components=1 -C node_modules/.pnpm/rolldown@1.0.0-rc.17/node_modules/rolldown/node_modules/@rolldown/binding-linux-x64-musl; \
    wget -q -O /tmp/rolldown-bindings/1.1.3.tgz https://registry.npmjs.org/@rolldown/binding-linux-x64-musl/-/binding-linux-x64-musl-1.1.3.tgz; \
    mkdir -p node_modules/.pnpm/rolldown@1.1.3/node_modules/rolldown/node_modules/@rolldown/binding-linux-x64-musl; \
    tar -xzf /tmp/rolldown-bindings/1.1.3.tgz --strip-components=1 -C node_modules/.pnpm/rolldown@1.1.3/node_modules/rolldown/node_modules/@rolldown/binding-linux-x64-musl; \
    rm -rf /tmp/rolldown-bindings

ENV NODE_OPTIONS=--max-old-space-size=2048
ENV VITE_BASE_URL=
ENV VITE_GLOB_API_URL=/admin-api
ENV VITE_APP_CAPTCHA_ENABLE=false
ENV VITE_APP_DOCALERT_ENABLE=false

# The production env file is loaded after process variables by this Vite setup.
# Patch only the image build context so local login sends the selected tenant.
RUN sed -i 's/^VITE_APP_CAPTCHA_ENABLE=.*/VITE_APP_CAPTCHA_ENABLE=false/' apps/web-antd/.env.production \
    && printf '\nVITE_APP_TENANT_ENABLE=true\n' >> apps/web-antd/.env.production

RUN pnpm run build:antd

FROM nginx:alpine

COPY deploy/frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /workspace/txgy-ui-admin-vben/apps/web-antd/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --retries=10 CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
