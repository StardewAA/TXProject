FROM node:22-bookworm-slim AS builder

WORKDIR /workspace/txgy-ui-admin-vben

RUN corepack enable && corepack prepare pnpm@11.7.0 --activate

COPY txgy-ui-admin-vben/ ./

ENV CI=true

# 复用宿主机预下载的 pnpm store（compose override 的 additional_context "pnpm-store"）。
# store 按 linux/x64/glibc 预取（见 .npmrc supported-architectures），故基础镜像用 bookworm(glibc)。
COPY --from=pnpm-store / /pnpm-store
RUN echo "STORE CONTENT:" && ls /pnpm-store && du -sh /pnpm-store
RUN pnpm install --frozen-lockfile --prefer-offline --store-dir=/pnpm-store

ENV NODE_OPTIONS=--max-old-space-size=2048
ENV VITE_BASE_URL=
ENV VITE_GLOB_API_URL=/admin-api
ENV VITE_APP_CAPTCHA_ENABLE=false
ENV VITE_APP_DOCALERT_ENABLE=false

# The production env file is loaded after process variables by this Vite setup.
# Patch only the image build context so local login sends the selected tenant.
RUN sed -i 's/^VITE_APP_CAPTCHA_ENABLE=.*/VITE_APP_CAPTCHA_ENABLE=false/' apps/web-antd/.env.production \
    && printf '\nVITE_APP_TENANT_ENABLE=true\n' >> apps/web-antd/.env.production

RUN pnpm run build:antd

FROM nginx:1.27-alpine

COPY deploy/frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /workspace/txgy-ui-admin-vben/apps/web-antd/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --retries=10 CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
