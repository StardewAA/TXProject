MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=ruoyi-vue-pro
NACOS_AUTH_TOKEN=eXVkYW8tbG9jYWwtZGV2ZWxvcG1lbnQtbmFjb3Mtc2VjcmV0LTIwMjY=
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=security
TZ=Asia/Shanghai

# Local Docker port overrides. Container-to-container ports remain unchanged.
MYSQL_PORT=3307
REDIS_PORT=6379
NACOS_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_GRPC_TLS_PORT=9849
GATEWAY_PORT=48080
FRONTEND_PORT=5173
VITE_MALL_PC_URL=

# Optional image overrides for a prebuilt local stack.
HRM_IMAGE=local-hrm:latest
FRONTEND_IMAGE=local-frontend:latest

# ===== 标书智能体 · 云端检索与生成（百炼 DashScope）=====
# 该文件是入库模板，只放键名与默认值；真实 key 写进同目录的 .env（已被 .gitignore 忽略），不要提交。
# 一把百炼 API-KEY 同时授权 embedding / rerank / qwen（控制台 → API-KEY 管理页创建）。
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
# Optional OSS credentials for infra_file_config values env:OSS_ACCESS_KEY / env:OSS_ACCESS_SECRET.
# Use rotated RAM credentials restricted to the intended bucket/prefix; do not commit real values.
OSS_ACCESS_KEY=
OSS_ACCESS_SECRET=
MALL_CUSTOMER_SERVICE_SCOPED_ENABLED=true
MALL_CUSTOMER_SERVICE_AI_ENABLED=false
