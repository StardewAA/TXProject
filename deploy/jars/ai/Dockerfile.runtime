# 薄镜像运行时：由宿主机上已打包好的 app.jar 直接构建，不在容器内跑 Maven。
# 构建上下文 = 本目录（deploy/jars/ai），app.jar 由宿主机 mvn package 后暂存。
#
# 说明：仓库远程版本的 Dockerfile.runtime 基于本机自制基础镜像 deploy-mes-base:latest，
# 该镜像在当前环境并不存在；这里与其它 20 支服务保持一致，改用 eclipse-temurin:25-jre，
# 并安装 curl 以配合 docker-compose.yml 的 /actuator/health 健康检查。
FROM eclipse-temurin:25-jre

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY app.jar /app/app.jar

ENV JAVA_OPTS=""

EXPOSE 48080

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]