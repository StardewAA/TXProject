<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0">
  <!-- Avoid repeatedly timing out on workstation-specific/unreachable mirrors. -->
  <mirrors>
    <mirror>
      <id>mall-central</id>
      <mirrorOf>*</mirrorOf>
      <url>https://repo.maven.apache.org/maven2</url>
    </mirror>
  </mirrors>
</settings>
