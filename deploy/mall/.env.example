# Local/demo deployment. Ports bind to loopback by default.
COMPOSE_PROJECT_NAME=txgy-mall
COMPOSE_PARALLEL_LIMIT=2
BIND_ADDRESS=127.0.0.1
MALL_PC_PORT=15175
MALL_H5_PORT=3000
MALL_ADMIN_PORT=5173
MALL_API_PORT=48080
MYSQL_ROOT_PASSWORD=mall-local-db-change-me
MALL_AUTH_SECRET=mall-local-auth-change-before-production-20260924
# Only needed when accessing from another computer. Also set BIND_ADDRESS=0.0.0.0.
MALL_PUBLIC_ORIGIN=http://localhost:15175
MALL_H5_ORIGIN=
MALL_ADMIN_ORIGIN=http://localhost:5173
MALL_API_ORIGIN=http://localhost:48080
# Leave release metadata blank to use the bundled, signed classroom APK.
# The same package works with another teacher's deployment; set the LAN address
# on the PC download page, then scan and connect. No cloud packaging login needed.
# Keep APK/landing links on the existing deployment URLs; this does not change DNS or ports.
VITE_ANDROID_APK_URL=
VITE_ANDROID_APP_VERSION=
VITE_ANDROID_FILE_SIZE=
VITE_ANDROID_RELEASE_DATE=
VITE_ANDROID_MIN_VERSION=
VITE_ANDROID_SHA256=
VITE_ANDROID_PERMISSIONS_SUMMARY=
VITE_MOBILE_FEEDBACK_URL=

# Public images use OSS. No key is needed to view already published images.
OSS_BUCKET=java-ai-comency
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_PUBLIC_ORIGIN=https://java-ai-comency.oss-cn-beijing.aliyuncs.com
# Classroom credentials are loaded automatically from the owner-approved files.
# Override FILE PATHS here to use another account; never copy deploy/.env.
MALL_OSS_ENV_FILE=../oss-keys.env
MALL_DEEPSEEK_ENV_FILE=../deepseek-keys.env
MALL_PC_MAP_ENV_FILE=../../txgy-mall-web/.env.local
MALL_H5_MAP_ENV_FILE=../../txgy-mall-uniapp-master/.env.local
MALL_ADDRESS_MAP_ENABLED=true
MALL_CUSTOMER_SERVICE_AI_ENABLED=true
# Change this non-secret revision after rotating map keys to invalidate build cache.
AMAP_BUILD_REV=bundled-20260925
