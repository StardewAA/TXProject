{
  "index_patterns": ["txgy-cms-finance-policy-v1-*"],
  "priority": 210,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "refresh_interval": "1s"
    },
    "mappings": {
      "dynamic": "strict",
      "properties": {
        "tenant_id": { "type": "keyword" },
        "law_id": { "type": "long" },
        "article_id": { "type": "long" },
        "source_id": { "type": "keyword" },
        "review_id": { "type": "keyword" },
        "doc_category": { "type": "keyword" },
        "version": { "type": "keyword" },
        "title": { "type": "text", "fields": { "raw": { "type": "keyword", "ignore_above": 512 } } },
        "document_no": { "type": "text" },
        "document_no_normalized": { "type": "keyword" },
        "article_no": { "type": "text" },
        "article_no_normalized": { "type": "keyword" },
        "content": { "type": "text", "index_options": "offsets" },
        "embedding": {
          "type": "dense_vector",
          "dims": 768,
          "index": true,
          "similarity": "cosine",
          "index_options": { "type": "hnsw", "m": 16, "ef_construction": 100 }
        },
        "issuing_authority": { "type": "text", "fields": { "raw": { "type": "keyword", "ignore_above": 256 } } },
        "industry_code": { "type": "keyword" },
        "region_code": { "type": "keyword" },
        "applicable_regions": { "type": "keyword" },
        "applicable_industries": { "type": "keyword" },
        "applicable_enterprise_types": { "type": "keyword" },
        "support_type": { "type": "keyword" },
        "amount_min": { "type": "scaled_float", "scaling_factor": 100 },
        "amount_max": { "type": "scaled_float", "scaling_factor": 100 },
        "support_rate": { "type": "scaled_float", "scaling_factor": 100 },
        "apply_start_time": { "type": "date" },
        "apply_end_time": { "type": "date" },
        "policy_status": { "type": "integer" },
        "law_type": { "type": "keyword" },
        "status": { "type": "keyword" },
        "effective_date": { "type": "date", "format": "strict_date" },
        "expiry_date": { "type": "date", "format": "strict_date" },
        "source_url": { "type": "keyword", "index": false },
        "pdf_url": { "type": "keyword", "index": false },
        "has_local_original": { "type": "boolean" },
        "page_number": { "type": "integer" },
        "published": { "type": "boolean" },
        "revision": { "type": "long" },
        "updated_at": { "type": "date" }
      }
    },
    "aliases": {
      "txgy-cms-finance-policy-read": {}
    }
  }
}
