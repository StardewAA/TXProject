# syntax=docker/dockerfile:1
# 后端编译验证专用：只编译 ai-server 及其依赖，验证新代码无编译错误
FROM maven:3.9-eclipse-temurin-25 AS builder

WORKDIR /workspace

COPY . .

RUN --mount=type=cache,target=/root/.m2/repository \
    mvn -pl txgy-module-ai/txgy-module-ai-server -am \
        -Dmaven.test.skip=true -Dmaven.artifact.threads=1 compile

FROM eclipse-temurin:25-jre
WORKDIR /app
COPY --from=builder /workspace /workspace
CMD ["echo", "compile ok"]
