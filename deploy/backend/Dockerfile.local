FROM maven:3.9.16-eclipse-temurin-25 AS builder

WORKDIR /workspace

COPY . .

RUN --mount=type=cache,id=txgycloud-maven-cache,target=/root/.m2,sharing=locked \
    mvn -Dmaven.test.skip=true package

ARG MODULE_PATH

RUN find "${MODULE_PATH}/target" -maxdepth 1 -type f -name '*.jar' ! -name 'original-*.jar' -exec cp '{}' /app.jar \; -quit \
    && test -f /app.jar

FROM maven:3.9.16-eclipse-temurin-25

WORKDIR /app

COPY --from=builder /app.jar /app/app.jar

ENV JAVA_OPTS=""

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]
