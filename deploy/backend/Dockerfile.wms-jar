# wms 服务 jar-only 镜像：复用本机 Maven 构建产物，无需容器内联网构建
# 前置步骤：
#   1) 本机编译：mvn -f pom.xml -pl :txgy-module-wms-server -am -Dmaven.test.skip=true package
#   2) 复制产物：txgy-module-wms/txgy-module-wms-server/target/*.jar -> deploy/backend/wms-app.jar
#   3) 构建：docker build -f deploy/backend/Dockerfile.wms-jar -t deploy-wms:latest .
# 基础镜像复用 deploy-mes-base:latest（含 JDK25 运行时 + curl，healthcheck 依赖）
FROM deploy-mes-base:latest

WORKDIR /app

COPY deploy/backend/wms-app.jar /app/app.jar

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]
