# syntax=docker/dockerfile:1
# MES 专用构建：只编译 mes-server 及其 reactor 依赖，避免全仓全量编译
FROM maven:3.9-eclipse-temurin-25 AS builder

WORKDIR /workspace

COPY . .

# cache mount 持久化 Maven 仓库；artifact.threads=1 串行下载避免大文件并发卡死
RUN --mount=type=cache,target=/root/.m2/repository \
    mvn -pl txgy-module-mes/txgy-module-mes-server -am \
        -Dmaven.test.skip=true -Dmaven.artifact.threads=1 package

RUN find "txgy-module-mes/txgy-module-mes-server/target" -maxdepth 1 -type f -name '*.jar' ! -name 'original-*.jar' -exec cp '{}' /app.jar \; -quit \
    && test -f /app.jar

FROM eclipse-temurin:25-jre

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app.jar /app/app.jar

ENV JAVA_OPTS=""

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]
