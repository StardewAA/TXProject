# 复制为 .env 后按需修改
# ---------- HTTP 服务 ----------
AGENT_HOST=127.0.0.1
AGENT_PORT=8080

# ---------- 入站鉴权与跨域（B1/B2）----------
# 逗号分隔；形如 key 或 key:租户A|租户B（绑定租户后只能访问这些租户的数据）
# 留空 = 不校验（启动会告警，仅建议本机开发）；生产环境务必配置
AGENT_API_KEYS=
# 未配置 AGENT_API_KEYS 时是否强制拒绝受保护接口（true 时全部返回 401）
AGENT_REQUIRE_AUTH=false
# 允许的跨域来源白名单（逗号分隔；填 * 表示放开）
AGENT_ALLOWED_ORIGINS=http://127.0.0.1:5180,http://localhost:5180
# 对外可访问的基础地址：Java 回拉上传文件时使用；留空按本机端口推断（跨机/容器部署必须配置）
AGENT_PUBLIC_BASE_URL=

# ---------- 日志 ----------
LOG_LEVEL=info

# ---------- Java 侧（txgy-module-bid）----------
# Java 侧：真实 txgy-server（单体）默认 48080；本地契约 mock 用 48081
JAVA_BASE_URL=http://127.0.0.1:48080
JAVA_API_KEY=
# 机对机鉴权密钥，对应 Java 侧 txgy.bid.agent-key（X-Agent-Key 请求头）
JAVA_AGENT_KEY=
JAVA_TIMEOUT_MS=30000
JAVA_MAX_RETRIES=3
# 影子状态上报（留空则关闭，关闭时不向 Java 推送任务状态）
JAVA_SHADOW_STATUS_PATH=/admin-api/bidding/bid-agent/contract/task-status
# 知识库入库/删除用的 Java 管理员凭据；留空则沿用内置默认账号 admin/admin123（生产请改为专用账号）
JAVA_ADMIN_USER=
JAVA_ADMIN_PASS=

# ---------- LLM（OpenAI 兼容，任意选一）----------
# 云端：阿里云百炼（DashScope 共享域名，兼容 sk-ws-* 通用 API Key，支持跨业务空间）
#   专属网关可选：https://{WorkspaceId}.{region}.maas.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen-plus
# 私有化：本地 vLLM / 云端其它 OpenAI 兼容网关
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_API_KEY=
LLM_TIMEOUT_MS=180000
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192

# ---------- 编排层后端 ----------
# openai-compat：直接用私有化 vLLM 的 OpenAI 兼容接口（默认）
# pi-sdk：加载 Pi SDK 适配器，需配合 PI_SDK_MODULE
SESSION_BACKEND=openai-compat
PI_SDK_MODULE=

# ---------- 检索 ----------
RETRIEVE_TOPK=8
# 说明：相似度阈值由 Java 侧检索服务决定，Agent 侧不再有 RETRIEVE_MIN_SCORE 配置项

# ---------- 编排参数 ----------
MAX_TOOL_ROUNDS=40
MAX_FIX_ATTEMPTS=3
HIL_WAIT_TIMEOUT_MS=86400000
# 并发与背压：同时执行的任务数与排队深度上限（超出直接 429）
MAX_CONCURRENT_TASKS=2
MAX_QUEUE_DEPTH=50
# 单任务 token 预算，0 表示不限制；超过后任务以 output_invalid 中止
MAX_TASK_TOKENS=0
# 断点续跑回灌的会话历史上限（条数 / 字符数）
RESUME_HISTORY_MESSAGES=12
RESUME_HISTORY_CHARS=6000
# SSE 长连接空闲上限（毫秒），到期由客户端重连
SSE_MAX_IDLE_MS=1800000

# ---------- 交付排版 ----------
# 是否允许调用本机 Word 将 docx 转 PDF（默认关闭；推荐改用独立转换服务）
PDF_VIA_WORD=false
# 标书模板 docx 路径（相对路径按服务根目录解析）：存在时最终交付件以「回填该模板」为准
# （字段填充 + 章节正文插入，保留模板封面/目录/页眉页脚）；留空则回退内置预览排版。
# 自动识别两种形态：「标签+留白」锚点模板与「书签占位」模板（书签模板按变量字典书签名回填，
# 基础变量名自动覆盖 _N/_appendix 变体）。
# 平台级内置主模板（2026-09-22 起）：templates/投标标书_主模板.docx（配套字典 templates/投标标书_变量字典.md，
# 机器可读字典 templates/bookmark-dict.json 由 tools/gen-bookmark-dict.mjs 生成）
BID_TEMPLATE_DOCX=templates/投标标书_主模板.docx

# ---------- 路径（留空则为 bid-agent-service 下的默认目录）----------
WORKSPACE_DIR=
SESSIONS_DIR=
