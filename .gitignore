# 千问中间脚本和文件存放位置（用户要求忽略）
千问中间脚本和文件存放位置/

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# Eclipse
.classpath
.project
.settings/
*.prefs

# VS Code
.vscode/

# Maven / Java 构建产物
target/
*.class
*.jar
*.war
*.ear
!**/src/main/**/*.jar
!**/src/test/**/*.jar

# LibreOffice 文档锁文件
.~lock.*#
~$*

# 日志与临时文件
*.log
logs/
*.tmp
*.temp
*.bak
*.swp
.DS_Store
Thumbs.db

# 编译/生成目录
out/
gen/

# Maven flatten 插件产物（IDE/Maven 构建生成，不入库）
.flattened-pom.xml

# 本地调试临时产物（截图/OCR/日志等）
.tmp_debug/

# 用户提供招投标资料目录（大数据/二进制，不入库；测试副本放 samples/）
docs/招投标版块数据提供/
