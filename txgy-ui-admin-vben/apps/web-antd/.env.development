# 端口号
VITE_PORT=5666

VITE_BASE=/

# 请求路径
VITE_BASE_URL=
# 接口地址：通过 Vite 同源代理转发，供局域网测试人员访问
# 浏览器请求 10.247.208.38:5666/admin-api，由 Vite 服务端转发到本机网关。
VITE_GLOB_API_URL=/admin-api
VITE_HRM_FILE_CONFIG_ID=22
VITE_HRM_FILE_STORAGE_HOST=test.txgy.iocoder.cn
# 文件上传类型：server - 后端上传， client - 前端直连上传，仅支持S3服务
VITE_UPLOAD_TYPE=server
# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 默认登录用户名
VITE_APP_DEFAULT_USERNAME=admin
# 默认登录密码
VITE_APP_DEFAULT_PASSWORD=admin123

# 应用标题（注入 index.html）
VITE_APP_TITLE=防腐保温智慧平台

# 多租户企业登录
VITE_APP_TENANT_ENABLE=true
