# 端口号
VITE_PORT=5666

VITE_BASE=/

# 请求路径
VITE_BASE_URL=
# 接口地址：开发环境直连后端网关（vite 代理对 POST body 有截断 bug，后端 CORS 已开放 *）
# 注意：baseURL 必须含 /admin-api 前缀，前端路径都是 /system/...（不含前缀）
VITE_GLOB_API_URL=http://localhost:48080/admin-api
# 文件上传类型：server - 后端上传， client - 前端直连上传，仅支持S3服务
VITE_UPLOAD_TYPE=server
# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 默认登录用户名
VITE_APP_DEFAULT_USERNAME=admin
# 默认登录密码
VITE_APP_DEFAULT_PASSWORD=admin123

# 多租户企业登录
VITE_APP_TENANT_ENABLE=true
