# 端口号
VITE_PORT=5173

VITE_BASE=/

# 浏览器标签标题
VITE_APP_TITLE=天信管业防腐保温智能平台

# 请求路径
VITE_BASE_URL=
# 接口地址：开发环境直连后端网关（vite 代理对 POST body 有截断 bug，后端 CORS 已开放 *）
# 注意：baseURL 必须含 /admin-api 前缀，前端路径都是 /system/...（不含前缀）
VITE_GLOB_API_URL=/admin-api
# 文件上传类型：server - 后端上传， client - 前端直连上传，仅支持S3服务
VITE_UPLOAD_TYPE=server
# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 是否启用多租户（true 显示登录页租户下拉，false 不显示）
VITE_APP_TENANT_ENABLE=true
# 默认租户编号
VITE_APP_DEFAULT_TENANT_ID=1

# 默认登录用户名
VITE_APP_DEFAULT_USERNAME=admin
# 默认登录密码
VITE_APP_DEFAULT_PASSWORD=admin123

# 应用标题（注入 index.html）
VITE_APP_TITLE=防腐保温智慧平台

# 多租户企业登录
VITE_APP_TENANT_ENABLE=true

# 全局关闭页面文档提示条
VITE_APP_DOCALERT_ENABLE=false

# 百度地图 AK（招聘职位地址选点 / 门户工作地点地图）
# 申请：https://lbsyun.baidu.com/ → 控制台创建「浏览器端」应用，白名单填写本系统访问域名
# 留空时：地址选点自动降级为「手动填写经纬度」，门户改为「百度地图查看位置」外链（不再白屏/报错）
# 也可不重新打包：在 index.html 注入 window.__BAIDU_MAP_AK__ = '你的AK' 即可生效
VITE_BAIDU_MAP_KEY=
