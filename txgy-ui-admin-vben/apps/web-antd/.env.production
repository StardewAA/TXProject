VITE_BASE=/

# 应用标识与标题
VITE_APP_NAMESPACE=txgy-admin
VITE_APP_TITLE=防腐保温智慧平台

# 请求路径
VITE_BASE_URL=
# 接口地址
VITE_GLOB_API_URL=/admin-api
VITE_HRM_FILE_CONFIG_ID=22
VITE_HRM_FILE_STORAGE_HOST=test.txgy.iocoder.cn
# 文件上传类型：server - 后端上传， client - 前端直连上传，仅支持S3服务
VITE_UPLOAD_TYPE=server

# 是否开启压缩，可以设置为 none, brotli, gzip
# gzip：构建期额外生成 .gz，配合 nginx gzip_static on 直接复用，降低首屏传输体积约 70%
VITE_COMPRESS=gzip

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true

# 验证码的开关
VITE_APP_CAPTCHA_ENABLE=false

# 应用标题（注入 index.html）
VITE_APP_TITLE=防腐保温智慧平台

# 租户模式：与后端默认开启的多租户配置保持一致
# 多租户开关
VITE_APP_TENANT_ENABLE=true

# 全局关闭页面文档提示条
VITE_APP_DOCALERT_ENABLE=false

# GoView 大屏设计器独立前端（Docker 部署的 goview 服务）：iframe 入口地址
# 会拼接 ?accessToken=xx&refreshToken=xx 实现免登进入设计器
VITE_GOVIEW_URL=http://localhost:5273/
